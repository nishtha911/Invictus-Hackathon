# COGNIS BANK Environment Configuration
# Mock API Switch: true = use realistic frontend mock simulation, false = call FastAPI backend
NEXT_PUBLIC_USE_MOCK_API=true

# Backend API base URL (FastAPI)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# OPTIONAL — separate outbound voice / follow-up CRM prototype (see /aivoiceassistance).
# Leave unset for the core MVP; the "AI Voice CRM" button and page stay hidden.
# NEXT_PUBLIC_VOICE_ASSISTANT_URL=http://localhost:5173
