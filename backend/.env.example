# /backend/.env.example
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-20b
ENVIRONMENT=development
LOG_LEVEL=INFO

# Supabase (RAG pgvector + leads + voice call log)
